{
  "name": "tc-generator-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Local web UI for the tc-generator pipeline (drives the existing slash commands via claude -p)",
  "scripts": {
    "build:client": "tsc -p tsconfig.client.json",
    "build": "tsc -p tsconfig.json && pnpm build:client",
    "dev": "pnpm build:client && tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --dir test",
    "e2e": "pnpm build:client && playwright test"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "csv-parse": "^5.6.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
